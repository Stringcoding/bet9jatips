"use client";
import { createClient } from "@/lib/supabase/client";
import { useEffect, useState } from "react";

export default function AdminTickerPage() {
  const [tickets, setTickets] = useState<any[]>([]);
  const supabase = createClient();

  useEffect(() => {
    supabase.from("winning_tickets").select("*").order("created_at", { ascending: false })
      .then(({ data }) => setTickets(data || []));
  }, []);

  return (
    <div className="p-6">
      <h1 className="text-2xl font-bold text-white mb-6">Manage Winning Ticker</h1>
      <div className="bg-bg-slate rounded-xl p-6 border border-gray-700">
        <form className="grid grid-cols-2 gap-4 mb-8">
           {/* Simplified form for adding a new winning ticket */}
           <input name="odds" placeholder="Odds (e.g. 23.50)" className="bg-bg-deep p-3 rounded text-white" />
           <input name="stake" placeholder="Stake (e.g. 1000)" className="bg-bg-deep p-3 rounded text-white" />
           <input name="return" placeholder="Return (e.g. 23500)" className="bg-bg-deep p-3 rounded text-white" />
           <input name="code" placeholder="Code" className="bg-bg-deep p-3 rounded text-white" />
           <button type="submit" className="bg-brand-green text-white font-bold rounded">Add Ticket</button>
        </form>

        {/* List to delete/edit existing tickets */}
        {tickets.map(t => (
          <div key={t.id} className="flex justify-between text-white border-b border-gray-800 py-2">
            <span>{t.odds} Odds | Code: {t.booking_code} | Return: ₦{t.return_amount}</span>
            <button className="text-brand-red">Delete</button>
          </div>
        ))}
      </div>
    </div>
  );
}
